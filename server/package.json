{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Node.js + Express + MongoDB + TypeScript boilerplate with security, logging, validation, and standardized API responses.",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier \"**/*.{ts,tsx,js,json,md}\" --write",
    "seed:faqs": "node src/scripts/seed-faqs.js"
  },
  "keywords": [
    "express",
    "mongoose",
    "typescript",
    "boilerplate",
    "security",
    "logging"
  ],
  "dependencies": {
    "@simplewebauthn/server": "13.1.2",
    "@types/ejs": "3.1.5",
    "bcryptjs": "3.0.2",
    "cloudinary": "2.7.0",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dadhich-bus-app": "file:..",
    "dotenv": "17.2.1",
    "ejs": "3.1.10",
    "express": "4.18.2",
    "express-mongo-sanitize": "2.2.0",
    "express-rate-limit": "8.0.1",
    "helmet": "8.1.0",
    "hpp": "0.2.3",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.17.1",
    "multer": "2.0.2",
    "next": "^14.0.0",
    "nodemailer": "7.0.5",
    "otplib": "12.0.1",
    "pino": "9.8.0",
    "pino-http": "10.5.0",
    "pino-pretty": "13.1.1",
    "qrcode": "1.5.4",
    "razorpay": "2.9.6",
    "socket.io": "4.8.1",
    "xlsx": "0.18.5",
    "zod": "4.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/bcryptjs": "3.0.0",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.21",
    "@types/hpp": "0.2.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "24.2.1",
    "@types/nodemailer": "6.4.17",
    "@types/qrcode": "1.5.5",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "eslint": "9.33.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "prettier": "3.6.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0"
  }
}
