# Dadhich Bus Services - Environment Configuration
# Copy this file to .env.local and fill in your actual values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://dadhichbusservice.com
NEXT_PUBLIC_SITE_NAME="Dadhich Bus Services"
NEXT_PUBLIC_SITE_DESCRIPTION="Premium bus rental and tour services across India"

# Search Engine Verification Codes
GOOGLE_VERIFICATION_CODE=your_google_verification_code_here
YANDEX_VERIFICATION_CODE=your_yandex_verification_code_here
YAHOO_VERIFICATION_CODE=your_yahoo_verification_code_here
BING_VERIFICATION_CODE=your_bing_verification_code_here

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXXX

# Google Search Console
GOOGLE_SEARCH_CONSOLE_VERIFICATION=your_verification_code_here

# Bing Webmaster Tools
BING_WEBMASTER_VERIFICATION=your_verification_code_here

# Yandex Webmaster
YANDEX_WEBMASTER_VERIFICATION=your_verification_code_here

# Social Media
NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id_here
NEXT_PUBLIC_TWITTER_HANDLE=@dadhichbusservice
NEXT_PUBLIC_INSTAGRAM_HANDLE=@dadhichbusservice
NEXT_PUBLIC_LINKEDIN_COMPANY=dadhichbusservice

# Contact Information
NEXT_PUBLIC_CONTACT_PHONE=+91-XXXXXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=info@dadhichbusservice.com
NEXT_PUBLIC_CONTACT_ADDRESS="Your Business Address, City, State, India"

# Business Information
NEXT_PUBLIC_BUSINESS_NAME="Dadhich Bus Services"
NEXT_PUBLIC_BUSINESS_TYPE="Travel Agency"
NEXT_PUBLIC_BUSINESS_CATEGORY="Transportation"
NEXT_PUBLIC_BUSINESS_HOURS="24/7"
NEXT_PUBLIC_BUSINESS_CURRENCY="INR"

# SEO Configuration
NEXT_PUBLIC_DEFAULT_LOCALE=en_IN
NEXT_PUBLIC_SUPPORTED_LOCALES=en_IN,hi_IN
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# Performance Configuration
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true
NEXT_PUBLIC_LAZY_LOADING=true
NEXT_PUBLIC_PRELOAD_CRITICAL_RESOURCES=true

# Security Configuration
NEXT_PUBLIC_CSP_ENABLED=true
NEXT_PUBLIC_HSTS_ENABLED=true
NEXT_PUBLIC_XSS_PROTECTION=true

# Cache Configuration
NEXT_PUBLIC_STATIC_CACHE_DURATION=31536000
NEXT_PUBLIC_DYNAMIC_CACHE_DURATION=3600
NEXT_PUBLIC_API_CACHE_DURATION=300
